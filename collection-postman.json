      "name": "Inscription client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/inscription",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prenom\": \"Sara\",\n  \"nom\": \"Test\",\n  \"email\": \"sara@example.com\",\n  \"mot_de_passe\": \"MotDePasse123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Connexion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
